---
import { site } from "../content/site";

const endpoint = import.meta.env.PUBLIC_HOSTEL_FORM_ENDPOINT ?? "";
const copy = site.hostels;
---

<form class="hostel-form" novalidate data-endpoint={endpoint} data-form="hostel">
	<div data-fields>
		<div class="form-grid cols-2">
			<div class="field">
				<label class="field-label" for="hostel-name">
					{copy.hostelName} <span class="req" aria-hidden="true">*</span>
				</label>
				<input id="hostel-name" name="hostel_name" type="text" autocomplete="organization" required aria-describedby="hostel-name-error" />
				<p id="hostel-name-error" class="field-error" hidden></p>
			</div>
			<div class="field">
				<label class="field-label" for="hostel-city">
					{copy.city} <span class="req" aria-hidden="true">*</span>
				</label>
				<input id="hostel-city" name="city" type="text" autocomplete="address-level2" required aria-describedby="hostel-city-error" />
				<p id="hostel-city-error" class="field-error" hidden></p>
			</div>
			<div class="field span-2">
				<label class="field-label" for="hostel-website">
					{copy.website} <span class="hint">({copy.websiteHint})</span>
				</label>
				<input id="hostel-website" name="website" type="text" inputmode="url" data-kind="url" autocomplete="url" aria-describedby="hostel-website-error" />
				<p id="hostel-website-error" class="field-error" hidden></p>
			</div>
			<div class="field">
				<label class="field-label" for="hostel-contact">
					{copy.contactName} <span class="req" aria-hidden="true">*</span>
				</label>
				<input id="hostel-contact" name="contact_name" type="text" autocomplete="name" required aria-describedby="hostel-contact-error" />
				<p id="hostel-contact-error" class="field-error" hidden></p>
			</div>
			<div class="field">
				<label class="field-label" for="hostel-email">
					{copy.email} <span class="req" aria-hidden="true">*</span>
				</label>
				<input id="hostel-email" name="email" type="email" autocomplete="email" required aria-describedby="hostel-email-error" />
				<p id="hostel-email-error" class="field-error" hidden></p>
			</div>
			<div class="field span-2">
				<label class="check" for="hostel-consent">
					<input id="hostel-consent" name="consent" type="checkbox" value="yes" required aria-describedby="hostel-consent-error" />
					<span>
						{copy.consentLead} <a href="/privacy">{copy.consentLink}</a> {copy.consentTail}
						<span class="req" aria-hidden="true">*</span>
					</span>
				</label>
				<p id="hostel-consent-error" class="field-error" hidden></p>
			</div>
		</div>

		<p class="hp" aria-hidden="true">
			<label>
				Leave this blank
				<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
			</label>
		</p>

		<p class="form-alert" data-alert role="alert" hidden></p>
		<button class="btn btn-red btn-reveal" type="submit" data-hostel-submit>
			<span class="btn-reveal-fill" aria-hidden="true"></span>
			<span data-label>{copy.submit}</span>
		</button>
	</div>
	<div class="success" data-success role="status" tabindex="-1" hidden>
		<p class="success-title">{copy.success.title}</p>
		<p class="success-body">
			{copy.success.body}<a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">{copy.success.instagram}</a>.
		</p>
	</div>
</form>

<script>
	import { bindForm } from "../scripts/form";
	import { bindButtonReveal } from "../scripts/buttonReveal";

	const hostelForm = document.querySelector<HTMLFormElement>("[data-form='hostel']");
	bindForm(hostelForm);
	bindButtonReveal(hostelForm?.querySelector<HTMLElement>("[data-hostel-submit]") ?? null);
</script>

<style>
	.hostel-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		min-height: 0;
	}

	.hostel-form [data-fields] {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.form-grid {
		margin-bottom: 0.35rem;
	}

	.hostel-form .check {
		text-transform: none;
	}

	.hostel-form .success {
		margin: 0;
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: clamp(0.85rem, 2vw, 1.15rem);
		padding: clamp(1.25rem, 3vw, 2rem);
		text-align: center;
		color: var(--black);
	}

	.hostel-form .success-title {
		margin: 0;
		font-family: var(--font-wordmark);
		font-size: clamp(2.75rem, 7vw, 4.25rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.03em;
		text-transform: none;
	}

	.hostel-form .success-body {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-lg);
		font-weight: 400;
		line-height: 1.35;
		max-width: 42ch;
		text-transform: uppercase;
	}

	.hostel-form .success-body a {
		color: inherit;
		font-weight: 500;
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.hostel-form .success-body a:hover {
		color: var(--red);
	}

	.hostel-form .success[hidden] {
		display: none;
	}

	@media (min-width: 960px) {
		.hostel-form {
			height: 100%;
		}

		.hostel-form [data-fields] {
			flex: 1;
			min-height: 0;
		}
	}
</style>
