---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	src: ImageMetadata;
	alt: string;
	widths?: number[];
	sizes?: string;
	loading?: "eager" | "lazy";
	fetchpriority?: "high" | "low" | "auto";
	class?: string;
	as?: "div" | "span";
	aspect?: string;
	objectPosition?: string;
}

const {
	src,
	alt,
	widths = [480, 800, 1200],
	sizes = "100vw",
	loading = "lazy",
	fetchpriority,
	class: className,
	as: Tag = "div",
	aspect = "auto",
	objectPosition = "center",
} = Astro.props;
---

<Tag class:list={["film", className]} style={`--aspect: ${aspect}; --pos: ${objectPosition};`}>
	<Image
		src={src}
		alt={alt}
		widths={widths}
		sizes={sizes}
		loading={loading}
		fetchpriority={fetchpriority}
	/>
	<slot />
</Tag>
