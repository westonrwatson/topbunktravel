---
import { Image } from "astro:assets";
import { site } from "../content/site";
import footerCat from "../assets/images/footer-cat.png";

interface Props {
	bare?: boolean;
}

const { bare = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={["site-footer", bare && "site-footer--bare"]}>
	<div class="wrap footer">
		<a class="wordmark" href="/">Top Bunk Travel</a>
		<div class="footer-bar">
			<ul class="footer-links">
				<li><a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a></li>
				<li><a href={site.tiktokUrl} target="_blank" rel="noopener noreferrer">TikTok</a></li>
				<li><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></li>
				<li><a href="/privacy">{site.footer.privacy}</a></li>
			</ul>
			<p class="copy">© {year} {site.footer.rights}</p>
		</div>
		<div class="footer-cat" aria-hidden="true">
			<Image
				src={footerCat}
				alt=""
				width={1024}
				height={969}
				widths={[160, 240, 320]}
				sizes="7.5rem"
				loading="lazy"
				decoding="async"
			/>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--red);
		padding: clamp(1rem, 2.5vw, 1.5rem) 0;
	}

	.site-footer--bare {
		background: var(--white);
		padding-block: clamp(1.5rem, 4vw, 2.5rem);
	}

	.footer {
		position: relative;
		overflow: visible;
		container-type: inline-size;
		display: grid;
		gap: clamp(1.25rem, 3vw, 2rem);
		background: var(--black);
		color: var(--white);
		border-radius: var(--radius);
		padding: clamp(1.15rem, 2.4vw, 1.85rem);
	}

	.footer-cat {
		display: none;
	}

	.wordmark {
		position: relative;
		z-index: 0;
		display: block;
		width: 100%;
		color: var(--yellow);
		font-size: clamp(1.7rem, 7.6cqi, 7.5rem);
		line-height: 0.82;
		white-space: nowrap;
	}

	.footer-bar {
		position: relative;
		z-index: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.85rem;
	}

	.footer-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.55rem;
	}

	.footer-links a {
		color: var(--white);
		text-decoration: none;
		font-size: var(--text-md);
		text-transform: uppercase;
		transition: opacity 0.15s ease;
	}

	.footer-links a:hover {
		opacity: 0.72;
	}

	.copy {
		margin: 0;
		font-size: var(--text-sm);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	@media (max-width: 799px) {
		.site-footer {
			padding-block: clamp(1.5rem, 5vw, 2.25rem);
		}

		.site-footer--bare {
			padding-block: clamp(2rem, 6vw, 3rem);
		}

		.footer {
			text-align: center;
			gap: clamp(1.75rem, 5vw, 2.75rem);
			padding: clamp(1.75rem, 5.5vw, 2.65rem);
		}

		.wordmark {
			text-align: center;
			font-size: clamp(2.25rem, 9.8cqi, 3.6rem);
		}

		.footer-bar {
			align-items: center;
			gap: 1.25rem;
		}

		.footer-links {
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: center;
			align-items: center;
			gap: 0.85rem 1.4rem;
		}
	}

	@media (min-width: 800px) {
		.footer-bar {
			flex-direction: row;
			align-items: baseline;
			justify-content: space-between;
			gap: 2rem;
		}

		.footer-links {
			flex-direction: row;
			align-items: baseline;
			gap: clamp(1.25rem, 3vw, 2.75rem);
		}

		.footer-cat {
			display: block;
			position: absolute;
			right: clamp(0.2rem, 0.8vw, 0.45rem);
			bottom: calc(clamp(1.15rem, 2.4vw, 1.85rem) + 2.35em);
			z-index: 2;
			line-height: 0;
			pointer-events: none;
		}

		.footer-cat :global(img) {
			display: block;
			width: min(16vw, 7.5rem);
			height: auto;
			object-fit: contain;
			object-position: bottom right;
			mix-blend-mode: screen;
		}
	}
</style>
