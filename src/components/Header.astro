---
import { site } from "../content/site";
import navStar from "../assets/images/nav-star.png";

const [left, right] = [site.nav.slice(0, 2), site.nav.slice(2)];
---

<header class="site-header">
	<a class="wordmark wordmark-mobile" href="/">
		<img class="wordmark-spark" src={navStar.src} alt="" width="1024" height="902" decoding="async" />
		{site.name}
	</a>
	<button
		type="button"
		class="burger"
		aria-expanded="false"
		aria-controls="site-nav"
	>
		<span class="sr-only" data-menu-label>Menu</span>
		<span class="burger-lines" aria-hidden="true"></span>
	</button>
	<nav id="site-nav" class="site-nav" aria-label="Primary">
		<div class="nav-group">
			{
				left.map((item) => (
					<a href={item.href}>{item.label}</a>
				))
			}
		</div>
		<a class="wordmark wordmark-desktop" href="/">
			<img class="wordmark-spark" src={navStar.src} alt="" width="1024" height="902" decoding="async" />
			{site.name}
		</a>
		<div class="nav-group">
			{
				right.map((item) => (
					<a href={item.href}>{item.label}</a>
				))
			}
		</div>
	</nav>
</header>

<script>
	import { initMenu } from "../scripts/menu";
	initMenu();
</script>

<style>
	.site-header .wordmark {
		position: relative;
		isolation: isolate;
		z-index: 0;
	}

	.site-header .wordmark-spark {
		position: absolute;
		left: 50%;
		top: 52%;
		z-index: -1;
		width: 3.4em;
		height: auto;
		transform: translate(-50%, -50%);
		pointer-events: none;
	}

	.site-header {
		position: relative;
		background: var(--white);
		z-index: 20;
	}

	.wordmark-mobile {
		position: relative;
		z-index: 2;
		display: block;
		width: 100%;
		padding-inline: 3rem;
		font-size: clamp(1.35rem, 6.4vw, 1.85rem);
		line-height: 1;
		text-align: center;
		white-space: nowrap;
	}

	.burger {
		position: absolute;
		right: var(--gutter);
		top: 50%;
		z-index: 2;
		transform: translateY(-50%);
		width: 48px;
		height: 48px;
		border: 0;
		background: transparent;
		padding: 0;
		cursor: pointer;
	}

	.burger-lines,
	.burger-lines::before,
	.burger-lines::after {
		display: block;
		width: 22px;
		height: 1.5px;
		background: var(--black);
		position: relative;
	}

	.burger-lines {
		margin: 0 auto;
	}

	.burger-lines::before,
	.burger-lines::after {
		content: "";
		position: absolute;
		left: 0;
	}

	.burger-lines::before {
		top: -7px;
	}

	.burger-lines::after {
		top: 7px;
	}

	.burger[aria-expanded="true"] .burger-lines {
		background: transparent;
	}

	.burger[aria-expanded="true"] .burger-lines::before {
		top: 0;
		transform: rotate(45deg);
	}

	.burger[aria-expanded="true"] .burger-lines::after {
		top: 0;
		transform: rotate(-45deg);
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 6rem;
		padding: 1.15rem var(--gutter);
	}

	.site-nav {
		display: none;
	}

	.nav-group {
		display: contents;
	}

	.site-nav.is-open {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		position: fixed;
		inset: 0;
		z-index: 1;
		height: 100dvh;
		background: var(--white);
		padding: 6.85rem var(--gutter) 2.5rem;
	}

	.site-nav a:not(.wordmark) {
		color: var(--black);
		text-decoration: none;
		padding: 0.35rem 0.5rem;
		border: 0;
		text-align: center;
		font-family: var(--font-sans);
		font-style: normal;
		font-size: var(--text-lg);
		line-height: 1.15;
		opacity: 0;
	}

	.site-nav.is-open a:not(.wordmark) {
		animation: nav-fade 0.55s ease forwards;
	}

	.site-nav.is-open .nav-group:first-child a:nth-child(1) {
		animation-delay: 0.05s;
	}

	.site-nav.is-open .nav-group:first-child a:nth-child(2) {
		animation-delay: 0.16s;
	}

	.site-nav.is-open .nav-group:last-child a:nth-child(1) {
		animation-delay: 0.27s;
	}

	.site-nav.is-open .nav-group:last-child a:nth-child(2) {
		animation-delay: 0.38s;
	}

	@keyframes nav-fade {
		from {
			opacity: 0;
			transform: translateY(0.7rem);
		}

		to {
			opacity: 1;
			transform: none;
		}
	}

	.wordmark-desktop {
		display: none;
	}

	:global(body.menu-open) {
		overflow: hidden;
	}

	@media (min-width: 960px) {
		.site-header {
			display: block;
			min-height: 0;
			padding: 1.5rem 0 1.35rem;
		}

		.wordmark-mobile,
		.burger {
			display: none;
		}

		.site-nav,
		.site-nav.is-open {
			display: grid;
			grid-template-columns: 1fr 1fr auto 1fr 1fr;
			align-items: center;
			justify-items: center;
			position: static;
			gap: 1rem;
			width: min(100% - var(--gutter) * 2, var(--wide));
			margin-inline: auto;
			padding: 0;
			border: 0;
			background: transparent;
		}

		.site-nav a:not(.wordmark),
		.site-nav.is-open a:not(.wordmark) {
			padding: 0.4rem 0;
			border: 0;
			opacity: 1;
			transform: none;
			animation: none;
			font-family: var(--font-sans);
			font-style: normal;
			font-size: var(--text-sm);
			font-weight: 500;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			line-height: 1.45;
		}

		.site-nav a:not(.wordmark):hover {
			color: var(--red);
		}

		.wordmark-desktop {
			display: inline-block;
			font-size: clamp(2.5rem, 4vw, 3.5rem);
			padding: 0 0.5rem;
		}

		.site-header .wordmark-desktop .wordmark-spark {
			width: 2.5em;
			top: 54%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-nav a:not(.wordmark),
		.site-nav.is-open a:not(.wordmark) {
			opacity: 1;
			transform: none;
			animation: none;
		}
	}
</style>
