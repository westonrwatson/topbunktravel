---
import { site } from "../content/site";
---

<div class="edge">
	<ul class="microstrip" aria-label="A few things we care about">
		{site.microLabels.map((label) => <li>{label}</li>)}
	</ul>
</div>

<style>
	.microstrip {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: baseline;
		gap: 0.25rem 0.6rem;
		list-style: none;
		margin: 0;
		padding: 1.15rem 0 clamp(1.25rem, 3vw, 2rem);
		color: var(--red);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		text-align: center;
	}

	/* Mobile: dots between the first three labels. */
	.microstrip li:nth-child(-n + 2)::after {
		content: "•";
		margin-left: 0.6rem;
	}

	.microstrip li:last-child {
		display: none;
	}

	@media (min-width: 800px) {
		.microstrip {
			justify-content: space-between;
			letter-spacing: 0.08em;
			text-align: left;
		}

		.microstrip li::after {
			content: none;
		}

		.microstrip li:last-child {
			display: list-item;
		}
	}
</style>
