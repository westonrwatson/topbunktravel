---
import { site } from "../content/site";
---

<div class="edge">
	<ul class="microstrip" aria-label="A few things we care about">
		{site.microLabels.map((label) => <li>{label}</li>)}
	</ul>
</div>

<style>
	.microstrip {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: baseline;
		list-style: none;
		margin: 0;
		padding: 1.15rem 0 clamp(1.25rem, 3vw, 2rem);
		color: var(--red);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.microstrip li:nth-child(1) {
		justify-self: start;
		text-align: left;
	}

	.microstrip li:nth-child(2) {
		justify-self: center;
		text-align: center;
	}

	.microstrip li:nth-child(3) {
		justify-self: end;
		text-align: right;
	}

	.microstrip li:last-child {
		display: none;
	}

	@media (min-width: 800px) {
		.microstrip {
			display: flex;
			justify-content: space-between;
			font-size: var(--text-sm);
			letter-spacing: 0.08em;
		}

		.microstrip li:nth-child(1),
		.microstrip li:nth-child(2),
		.microstrip li:nth-child(3) {
			justify-self: auto;
			text-align: left;
		}

		.microstrip li:last-child {
			display: list-item;
		}
	}
</style>
