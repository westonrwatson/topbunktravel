---
import { Image } from "astro:assets";
import { site } from "../content/site";
import lot from "../assets/images/how-lot-duotone.jpg";
---

<section class="section how" id="how-it-works" aria-labelledby="how-title">
	<div class="edge">
		<h2 id="how-title" class="sr-only">{site.how.title}</h2>
		<p class="how-copy">
			{site.how.lines.map((line) => <span class="how-line">{line}</span>)}
		</p>
		<div class="how-visual">
			<Image
				src={lot}
				alt="A red and black silhouette of parked vans, signs, and a plane taking off."
				widths={[480, 800, 993]}
				sizes="100vw"
			/>
		</div>
	</div>
</section>

<style>
	.how {
		position: relative;
		overflow: hidden;
		background: var(--red);
		color: var(--white);
		padding-block: clamp(1.5rem, 3vw, 2.25rem) clamp(2.75rem, 8vw, 4.5rem);
		min-height: 58svh;
		display: flex;
		align-items: flex-start;
	}

	.how-copy {
		position: relative;
		z-index: 1;
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-lg);
		font-weight: 400;
		line-height: 1.15;
		text-align: left;
		text-transform: uppercase;
	}

	.how-line {
		display: block;
	}

	@media (min-width: 800px) {
		.how {
			padding-bottom: calc(var(--section) * 1.6);
			min-height: min(78svh, 720px);
		}

		.how-copy {
			width: 66.667%;
		}
	}

	.how-visual {
		position: absolute;
		inset: 0;
		margin: 0;
		pointer-events: none;
	}

	.how-visual :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}
</style>
