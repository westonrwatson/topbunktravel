---
import { site } from "../content/site";
---

<section class="section" id="how-it-works" aria-labelledby="how-title">
	<div class="wrap">
		<h2 id="how-title" class="section-title" data-reveal>{site.how.title}</h2>
		<ol class="steps">
			{
				site.how.steps.map((step, index) => (
					<li data-reveal>
						<span class="num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
						<p>{step}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.steps {
		list-style: none;
		margin: clamp(1.75rem, 4vw, 2.75rem) 0 0;
		padding: 0;
		display: grid;
		gap: 2rem;
	}

	.num {
		display: block;
		color: var(--red);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(3.2rem, 6vw, 4.75rem);
		line-height: 0.85;
		margin-bottom: 0.7rem;
	}

	.steps p {
		max-width: 28rem;
		font-size: 1.05rem;
	}

	@media (min-width: 800px) {
		.steps {
			grid-template-columns: repeat(3, 1fr);
			gap: 2rem;
		}
	}
</style>
