---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../content/site";

// TODO: Replace this page with a privacy policy reviewed by counsel
// before collecting real email addresses.
const page = site.privacy;
---

<BaseLayout title={`${page.title} | ${site.legalName}`} description={page.description}>
	<div class="privacy-page">
		<Header />
		<main id="main" class="privacy">
			<article class="wrap">
				<h1>{page.title}</h1>
				{
					page.sections.map((section) => (
						<section>
							<h2>{section.heading}</h2>
							<p>{section.body}</p>
						</section>
					))
				}
				<p class="back"><a href="/">Back to Top Bunk</a></p>
			</article>
		</main>
		<Footer bare />
	</div>
</BaseLayout>

<style>
	.privacy-page {
		display: flex;
		flex-direction: column;
		min-height: 100svh;
	}

	.privacy {
		flex: 1;
		padding-block: clamp(2.5rem, 6vw, 4.5rem);
		text-transform: none;
	}

	article {
		display: grid;
		gap: 1.5rem;
	}

	h1 {
		font-family: var(--font-wordmark);
		font-style: normal;
		font-weight: 400;
		font-size: var(--step-h2);
		line-height: 0.9;
		letter-spacing: -0.035em;
		color: var(--red);
	}

	h2 {
		font-family: var(--font-sans);
		font-style: normal;
		font-weight: 500;
		font-size: var(--text-lg);
		margin-bottom: 0.4rem;
	}

	section {
		display: grid;
		gap: 0.35rem;
	}

	.back {
		margin-top: 0.5rem;
	}
</style>
