---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import MicroLabels from "../components/MicroLabels.astro";
import HowItWorks from "../components/HowItWorks.astro";
import RouteCarousel from "../components/RouteCarousel.astro";
import TravelerForm from "../components/TravelerForm.astro";
import HostelSection from "../components/HostelSection.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout>
	<Header />
	<main id="main">
		<Hero />
		<MicroLabels />
		<HowItWorks />
		<RouteCarousel />
		<HostelSection />
		<TravelerForm />
	</main>
	<Footer />
</BaseLayout>
