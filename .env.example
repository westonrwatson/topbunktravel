# Public site URL used for canonical and social tags. No trailing slash.
PUBLIC_SITE_URL=https://topbunktravel.westonwatson.com

# Formspree (or similar) endpoints. Leave blank locally to see the "not connected" error.
# Traveler waitlist: https://formspree.io/f/your-traveler-id
PUBLIC_TRAVELER_FORM_ENDPOINT=

# Hostel interest: https://formspree.io/f/your-hostel-id
PUBLIC_HOSTEL_FORM_ENDPOINT=
