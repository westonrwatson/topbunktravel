# Public site URL used for canonical and social tags. No trailing slash.
PUBLIC_SITE_URL=https://topbunktravel.westonwatson.com

# Google Sheets web app URL (recommended). See docs/GOOGLE_SHEETS.md.
# One URL handles waitlist, waitlist survey, and hostels tabs.
PUBLIC_FORMS_ENDPOINT=

# Optional overrides (Formspree or separate endpoints). Ignored when PUBLIC_FORMS_ENDPOINT is set.
PUBLIC_TRAVELER_FORM_ENDPOINT=
PUBLIC_HOSTEL_FORM_ENDPOINT=
